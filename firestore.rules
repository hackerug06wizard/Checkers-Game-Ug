rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      // Anyone can read user profiles for leaderboards and multiplayer matching
      allow read: if true;
      
      // Users can create/update their own profile
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow profile creation during Google/Apple sign-up
      allow write: if isAuthenticated();
    }

    // Match Rooms collection rules
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Global Chat & Leaderboard rules
    match /chat/{messageId} {
      allow read, create: if true;
    }

    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
