rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection rules - allow reading and writing for all in-app user profiles
    match /users/{userId} {
      allow read, write, create, update: if true;
    }

    // Match Rooms collection rules for real-time multiplayer
    match /rooms/{roomId} {
      allow read, write, create, update, delete: if true;
    }

    // Global Chat messages
    match /chat/{messageId} {
      allow read, write, create: if true;
    }

    // Leaderboards collection
    match /leaderboard/{entry} {
      allow read, write, create, update: if true;
    }

    // Global document access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

