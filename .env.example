# Netlify Environment Variables Configuration

# 1. Firebase Configuration (Mandatory for Netlify static build)
VITE_FIREBASE_API_KEY=AIzaSyCEzDbBHKvmL0qg19CnvCCRZsYwx03NlTc
VITE_FIREBASE_AUTH_DOMAIN=checkers-game-ug.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=checkers-game-ug
VITE_FIREBASE_STORAGE_BUCKET=checkers-game-ug.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=726155928996
VITE_FIREBASE_APP_ID=1:726155928996:web:4e4cd4d3160e2fd5514d31

# 2. Real-time Multiplayer WebSocket Backend Server URL (Optional)
# If Netlify is hosting the static frontend SPA and your Node.js WebSocket server is hosted separately (e.g. Render, Railway, Heroku, Cloud Run), set the backend WebSocket URL here:
# VITE_WS_URL=wss://your-backend-server.onrender.com

# 3. Yo! Payments Direct Mobile Money Gateway (Uganda MTN MoMo & Airtel Money)
# Get your API Username & API Password from https://paymentsapi.yo.co.ug / https://sandbox.yo.co.ug
YO_PAYMENTS_API_USERNAME=
YO_PAYMENTS_API_PASSWORD=
# Environment: 'sandbox' (testing with sandbox.yo.co.ug) or 'live' (production with paymentsapi1.yo.co.ug)
YO_PAYMENTS_ENVIRONMENT=live
# Default Currency (UGX)
YO_PAYMENTS_CURRENCY=UGX

# 4. Pesapal Payment Gateway Integration (Alternative / Optional)
# Get your Consumer Key and Consumer Secret from https://developer.pesapal.com or https://pay.pesapal.com
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CURRENCY=UGX
PESAPAL_IPN_ID=

# 5. App Metadata / Public URL
VITE_APP_NAME="Checkers Online - Android App"
APP_URL=https://checkers-game-ug.netlify.app

